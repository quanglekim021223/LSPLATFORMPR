APP_ENV=local
# DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=INFO
SCHEDULER_ENABLED=false
INGESTION_TIME=05:00
INGESTION_TIMEZONE=Asia/Ho_Chi_Minh

LEVELUP_BASE_URL=https://rest.myabsorb.eu
LEVELUP_AUTH_PATH=/authenticate
LEVELUP_COURSES_PATH=/courses
LEVELUP_USERNAME=
LEVELUP_PASSWORD=
LEVELUP_API_KEY=
LEVELUP_API_VERSION=2
LEVELUP_PAGE_SIZE=1000
LEVELUP_MAX_CONCURRENCY=5
LEVELUP_LOCK_TTL_SECONDS=3600

SKILLUP_INTELLIGENCE_BASE_URL=https://api.skillsintelligence.imocha.io
SKILLUP_REPORTS_BASE_URL=https://apiv3.imocha.io
SKILLUP_API_KEY=
SKILLUP_PAGE_SIZE=100
SKILLUP_ASSESSMENT_START_DATE=2000-01-01T00:00:00Z

DATACAMP_BASE_URL=
DATACAMP_TOKEN=
DATACAMP_EVENTS_PAGE_SIZE=1000

COURSERA_TOKEN_URL=https://api.coursera.com/oauth2/client_credentials/token
COURSERA_BASE_URL=
COURSERA_USERNAME=
COURSERA_PASSWORD=
COURSERA_ORG_ID=
COURSERA_CONTENT_DETAIL_PATH_TEMPLATE=
COURSERA_PAGE_SIZE=100
COURSERA_MAX_CONCURRENCY=5
COURSERA_LOCK_TTL_SECONDS=3600

LINKEDIN_TOKEN_URL=https://www.linkedin.com/oauth/v2/accessToken
LINKEDIN_BASE_URL=https://api.linkedin.com/v2
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_PAGE_SIZE=100
LINKEDIN_HISTORY_START_TIME=2000-01-01T00:00:00Z
LINKEDIN_MAX_CONCURRENCY=5
LINKEDIN_ASSET_DETAIL_QUERY_TEMPLATE=
LINKEDIN_LOCK_TTL_SECONDS=3600

HARVARD_CATALOG_BASE_URL=https://catalog-api.myhbp.org/v1
HARVARD_PAGE_SIZE=1000

HARVARD_HMM_CLIENT_ID=
HARVARD_HMM_CLIENT_SECRET=
HARVARD_HMM_ORG_KEY=
HARVARD_HMM_HISTORY_START_DATE=

HARVARD_SPARK_CLIENT_ID=
HARVARD_SPARK_CLIENT_SECRET=
HARVARD_SPARK_ORG_KEY=
HARVARD_SPARK_HISTORY_START_DATE=

HARVARD_SFTP_HOST=transfer.hbsp.harvard.edu
HARVARD_SFTP_PORT=22
HARVARD_SFTP_USERNAME=
HARVARD_SFTP_PASSWORD=
HARVARD_SFTP_REMOTE_DIR=/fpt_sparkprod_feed
# Local mock: ./src/app/mocks/harvard_known_hosts
# Production: replace with the path to the trusted OpenSSH known-hosts file.
HARVARD_SFTP_KNOWN_HOSTS=./src/app/mocks/harvard_known_hosts
HARVARD_REPORT_DATE_OFFSET_DAYS=1
HARVARD_SFTP_POLL_INTERVAL_SECONDS=300
HARVARD_SFTP_MAX_WAIT_SECONDS=7200
HARVARD_SFTP_MAX_RETRIES=3
# Local demo only: generate mock CSV files without connecting to a real SFTP server.
HARVARD_SFTP_MOCK_ENABLED=true

FAMS_BASE_URL=https://fams.fa.edu.vn
FAMS_API_KEY=

# full: pull all training data and ignore the four filters below.
# filtered: send only the non-empty filters below. Allowed values: full, filtered.
FAMS_LOAD_MODE=full

# Optional filters used only when FAMS_LOAD_MODE=filtered.
# Multiple statuses can be comma-separated, for example: CLOSED,INPROGRESS.
FAMS_STATUS=
# Site examples from the contract: HN, DN, HCM.
FAMS_SITE=
# Inclusive date range in YYYYMMDD format, for example: 20260101.
FAMS_ACTUAL_START_DATE_FROM=
FAMS_ACTUAL_START_DATE_TO=

FAMS_LOCK_TTL_SECONDS=3600

HTTP_MAX_RETRIES=3
HTTP_CONNECT_TIMEOUT_SECONDS=10
HTTP_READ_TIMEOUT_SECONDS=60

BRONZE_STORAGE_TYPE=local
BRONZE_LOCAL_PATH=./data/bronze
CHECKPOINT_DB_PATH=./data/state/ingestion.db
CHECKPOINT_RETENTION_DAYS=30

# Local mock vendor credentials. They are independent from the client-side
# values above, just like credentials stored by a real vendor.
MOCK_LEVELUP_USERNAME=mock-user
MOCK_LEVELUP_PASSWORD=mock-password
MOCK_LEVELUP_API_KEY=mock-private-key
MOCK_LEVELUP_API_VERSION=2
MOCK_LEVELUP_ACCESS_TOKEN=mock-levelup-token
MOCK_SKILLUP_API_KEY=mock-skillup-key
MOCK_DATACAMP_TOKEN=mock-datacamp-token
MOCK_COURSERA_USERNAME=mock-coursera-user
MOCK_COURSERA_PASSWORD=mock-coursera-password
MOCK_COURSERA_ORG_ID=mock-org
MOCK_COURSERA_ACCESS_TOKEN=mock-coursera-token
MOCK_LINKEDIN_CLIENT_ID=mock-linkedin-client
MOCK_LINKEDIN_CLIENT_SECRET=mock-linkedin-secret
MOCK_LINKEDIN_ACCESS_TOKEN=mock-linkedin-token
MOCK_HARVARD_HMM_CLIENT_ID=mock-hmm-client
MOCK_HARVARD_HMM_CLIENT_SECRET=mock-hmm-secret
MOCK_HARVARD_HMM_ORG_KEY=mock-hmm-org
MOCK_HARVARD_HMM_ACCESS_TOKEN=mock-hmm-token
MOCK_HARVARD_SPARK_CLIENT_ID=mock-spark-client
MOCK_HARVARD_SPARK_CLIENT_SECRET=mock-spark-secret
MOCK_HARVARD_SPARK_ORG_KEY=mock-spark-org
MOCK_HARVARD_SPARK_ACCESS_TOKEN=mock-spark-token
MOCK_HARVARD_SFTP_HOST=mock-harvard-sftp
MOCK_HARVARD_SFTP_USERNAME=mock-harvard-sftp-user
MOCK_HARVARD_SFTP_PASSWORD=mock-harvard-sftp-password
MOCK_HARVARD_SFTP_HOST_KEY="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIANeqwMmZ87//cJ6mwB8qeyF+egQrDQhkRrsyhymF8UO"
MOCK_FAMS_API_KEY=mock-fams-key
