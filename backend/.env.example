# Application
APP_ENV=local
LOG_LEVEL=INFO
SCHEDULER_ENABLED=false
INGESTION_TIME=05:00
INGESTION_TIMEZONE=Asia/Ho_Chi_Minh
CORS_ALLOWED_ORIGINS=["https://fsa-data-ingest-function-app-dev-001-arbea9faa7fngxdu.southeastasia-01.azurewebsites.net"]

# Local values come from .env. In Azure, map the password hash and JWT secret
# through Function App settings backed by Key Vault References.
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD_HASH=$2b$12$EixZaYVK1fsbw1ZfbX3OXePaWxn96p36WQoeg6Lruj3vjPGga31lW
AUTH_JWT_SECRET=super-secret-key-for-jwt-fsa-datalake-2026-xyz
AUTH_TOKEN_EXPIRE_MINUTES=60

# Azure Function timer (NCRONTAB, UTC)
INGESTION_TIMER_SCHEDULE=0 0 22 * * *
# Keep true until deployment, checkpoint seed, and smoke test are complete.
AzureWebJobs.scheduled_vendor_ingestion.Disabled=true

# LevelUP
LEVELUP_BASE_URL=https://rest.myabsorb.eu
LEVELUP_USER_NAME=
LEVELUP_PASSWORD=
LEVELUP_KEY=

# SkillUP
SKILLUP_KEY=

# DataCamp
DATACAMP_BASE_URL=
DATACAMP_TOKEN=

# Coursera
COURSERA_TOKEN_URL=https://api.coursera.com/oauth2/client_credentials/token
COURSERA_BASE_URL=
COURSERA_USER_NAME=
COURSERA_PASSWORD=
COURSERA_ORGID=
COURSERA_CONTENT_DETAIL_PATH_TEMPLATE=/{org_id}/contents/{id}

# LinkedIn Learning
LINKEDIN_TOKEN_URL=https://www.linkedin.com/oauth/v2/accessToken
LINKEDIN_BASE_URL=https://api.linkedin.com/v2
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_GRANT_TYPE=client_credentials
LINKEDIN_HISTORY_START_TIME=2000-01-01T00:00:00Z

# Harvard HMM and Spark
HARVARD_CATALOG_BASE_URL=https://catalog-api.myhbp.org/v1
HARVARD_API_USER_NAME=
HARVARD_API_PASSWORD=
HARVARD_ORGID=
HARVARD_SFTP_HOST=transfer.hbsp.harvard.edu
HARVARD_SFTP_PORT=22
HARVARD_SFTP_USER_NAME=
HARVARD_SFTP_PASSWORD=
HARVARD_SFTP_REMOTE_DIR=/fpt_sparkprod_feed

# FAMS
FAMS_TOKEN=

# Fabric Bronze and durable checkpoint state
# Set true in the Function App after RBAC, checkpoint seed, and smoke testing.
FABRIC_ENABLED=false
FABRIC_WORKSPACE_ID=
FABRIC_LAKEHOUSE_ID=
FABRIC_SCHEMA=dbo
FABRIC_STATE_ACCOUNT_URL=
FABRIC_STATE_CONTAINER=fabric-ingestion-state
# Empty uses the Function App system-assigned managed identity.
FABRIC_MANAGED_IDENTITY_CLIENT_ID=
FABRIC_VENDORS=["skillup"]
FABRIC_MAX_CONCURRENT_VENDORS=1
FABRIC_ALLOW_INITIAL_PULL=false
# Function App local status/checkpoint path. Durable Fabric state remains in Blob.
CHECKPOINT_DB_PATH=./data/state/ingestion.db

# Local-only fallback when Fabric is disabled
BRONZE_STORAGE_TYPE=local
BRONZE_LOCAL_PATH=./data/bronze
