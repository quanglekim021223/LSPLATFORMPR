APP_ENV=local
# DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=INFO
SCHEDULER_ENABLED=false
INGESTION_TIME=05:00
INGESTION_TIMEZONE=Asia/Ho_Chi_Minh
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Local values come from .env. In Azure, map the password hash and JWT secret
# through Function App settings backed by Key Vault References.
AUTH_ADMIN_USERNAME=
AUTH_ADMIN_PASSWORD_HASH=
AUTH_JWT_SECRET=
AUTH_TOKEN_EXPIRE_MINUTES=60

LEVELUP_BASE_URL=https://rest.myabsorb.eu
LEVELUP_AUTH_PATH=/authenticate
LEVELUP_COURSES_PATH=/courses
LEVELUP_USERNAME=
LEVELUP_PASSWORD=
# Azure name: LEVELUP_KEY (legacy LEVELUP_API_KEY remains supported).
LEVELUP_KEY=
LEVELUP_API_VERSION=2
LEVELUP_PAGE_SIZE=1000
LEVELUP_MAX_CONCURRENCY=5
LEVELUP_LOCK_TTL_SECONDS=3600

SKILLUP_INTELLIGENCE_BASE_URL=https://api.skillsintelligence.imocha.io
SKILLUP_REPORTS_BASE_URL=https://apiv3.imocha.io
# Azure name: SKILLUP_KEY (legacy SKILLUP_API_KEY remains supported).
SKILLUP_KEY=
SKILLUP_PAGE_SIZE=100
# Earliest date used for the initial and periodic Assessment History full sync.
SKILLUP_ASSESSMENT_START_DATE=2000-01-01T00:00:00Z
# Daily sync starts three days before the last successful watermark.
SKILLUP_ASSESSMENT_DAILY_OVERLAP_DAYS=3
# Re-read the configured lookback window once a week.
SKILLUP_ASSESSMENT_WEEKLY_SYNC_INTERVAL_DAYS=7
SKILLUP_ASSESSMENT_LOOKBACK_DAYS=90

DATACAMP_BASE_URL=
DATACAMP_TOKEN=
DATACAMP_EVENTS_PAGE_SIZE=1000
# Earliest event timestamp used by the first and monthly full-history sync.
DATACAMP_EVENTS_START_TIME=2000-01-01T00:00:00Z
# Daily sync starts three days before the last successful watermark.
DATACAMP_EVENTS_DAILY_OVERLAP_DAYS=3
# Weekly reconciliation re-reads this many days of event history.
DATACAMP_EVENTS_LOOKBACK_DAYS=90

COURSERA_TOKEN_URL=https://api.coursera.com/oauth2/client_credentials/token
COURSERA_BASE_URL=
# Legacy COURSERA_USERNAME remains supported.
COURSERA_USER_NAME=
COURSERA_PASSWORD=
COURSERA_ORG_ID=
COURSERA_CONTENT_DETAIL_PATH_TEMPLATE=
COURSERA_PAGE_SIZE=100
COURSERA_MAX_CONCURRENCY=5
# Daily sync starts three days before the last successful watermark.
COURSERA_HISTORY_DAILY_OVERLAP_DAYS=3
# Weekly Learning History reconciliation re-reads this many days of activity.
COURSERA_HISTORY_LOOKBACK_DAYS=90
COURSERA_LOCK_TTL_SECONDS=3600

LINKEDIN_TOKEN_URL=https://www.linkedin.com/oauth/v2/accessToken
LINKEDIN_BASE_URL=https://api.linkedin.com/v2
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_GRANT_TYPE=client_credentials
LINKEDIN_PAGE_SIZE=100
# Earliest timestamp used by the first and monthly full-history sync.
LINKEDIN_HISTORY_START_TIME=2000-01-01T00:00:00Z
# Daily overlap and weekly reconciliation windows for late or corrected activity.
LINKEDIN_HISTORY_DAILY_LOOKBACK_DAYS=3
LINKEDIN_HISTORY_LOOKBACK_DAYS=90
LINKEDIN_MAX_CONCURRENCY=5
LINKEDIN_ASSET_DETAIL_QUERY_TEMPLATE=
LINKEDIN_LOCK_TTL_SECONDS=3600

HARVARD_CATALOG_BASE_URL=https://catalog-api.myhbp.org/v1
HARVARD_PAGE_SIZE=1000
# Azure shared credentials: HARVARD_API_USER_NAME and HARVARD_API_PASSWORD.
# Used as fallback for both HMM and Spark by the existing Basic OAuth client.
# When using the shared pair, OMIT the four vendor-specific CLIENT fields below
# from your configuration; even explicitly empty fields override shared values.
# Separate ORG_KEY values are still required for HMM and Spark.

HARVARD_HMM_CLIENT_ID=
HARVARD_HMM_CLIENT_SECRET=
HARVARD_HMM_ORG_KEY=
HARVARD_HMM_HISTORY_START_DATE=

HARVARD_SPARK_CLIENT_ID=
HARVARD_SPARK_CLIENT_SECRET=
HARVARD_SPARK_ORG_KEY=
HARVARD_SPARK_HISTORY_START_DATE=

HARVARD_SFTP_HOST=transfer.hbsp.harvard.edu
HARVARD_SFTP_PORT=22
# Legacy HARVARD_SFTP_USERNAME remains supported.
HARVARD_SFTP_USER_NAME=
HARVARD_SFTP_PASSWORD=
HARVARD_SFTP_REMOTE_DIR=/fpt_sparkprod_feed
# Path to a packaged, trusted OpenSSH known-hosts file.
HARVARD_SFTP_KNOWN_HOSTS=
HARVARD_REPORT_DATE_OFFSET_DAYS=1
HARVARD_SFTP_POLL_INTERVAL_SECONDS=300
HARVARD_SFTP_MAX_WAIT_SECONDS=7200
HARVARD_SFTP_MAX_RETRIES=3

FAMS_BASE_URL=https://fams.fa.edu.vn
# Same key as Azure Function App.
FAMS_TOKEN=

# full: pull all training data and ignore the four filters below.
# filtered: send only the non-empty filters below. Allowed values: full, filtered.
FAMS_LOAD_MODE=full

# Optional filters used only when FAMS_LOAD_MODE=filtered.
# Multiple statuses can be comma-separated, for example: CLOSED,INPROGRESS.
FAMS_STATUS=
# Site examples from the contract: HN, DN, HCM.
FAMS_SITE=
# Inclusive date range in YYYYMMDD format, for example: 20260101.
FAMS_ACTUAL_START_DATE_FROM=
FAMS_ACTUAL_START_DATE_TO=

FAMS_LOCK_TTL_SECONDS=3600

HTTP_MAX_RETRIES=3
HTTP_CONNECT_TIMEOUT_SECONDS=10
HTTP_READ_TIMEOUT_SECONDS=60

BRONZE_STORAGE_TYPE=local
BRONZE_LOCAL_PATH=./data/bronze
# Required only when BRONZE_STORAGE_TYPE=adls.
ADLS_ACCOUNT_NAME=
ADLS_FILE_SYSTEM=bronze
ADLS_BASE_PATH=
CHECKPOINT_DB_PATH=./data/state/ingestion.db
CHECKPOINT_RETENTION_DAYS=30
